{
  "name": "ai-decor-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare:assets": "node scripts/sync-three-assets.mjs",
    "test:e2e": "playwright test",
    "dev:vinext": "npm run prepare:assets && vite dev --port 3001",
    "build:vinext": "npm run prepare:assets && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "cf deploy --prebuilt --secrets-file .env.local"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/react": "^4.0.167",
    "@vinext/cloudflare": "^1.3.3",
    "ai": "^7.0.163",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "three": "0.160.0",
    "vinext": "^1.4.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0"
  },
  "type": "module"
}
