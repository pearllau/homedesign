# ===== DeepSeek API 配置 =====
# 复制本文件为 .env.local 并填入真实值（.env.local 已被 git 忽略，不会提交）

# DeepSeek API 密钥（必填，sk- 开头）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 对话模型（可选，默认 deepseek-chat）
# 可选: deepseek-chat / deepseek-reasoner / deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat

# 可选：用于本地 Node.js 开发以及未来阿里云部署的 OpenAI 兼容视觉 API。
# 使用此路径时下面三项均必填；API Key留空不会发起视觉API请求。
# 百炼/DashScope 国内兼容接口候选基址；国际地域可改为对应地域的官方地址。
# 需核对文档与账号权限：https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 在阿里云百炼模型服务创建 API Key 后填入；勿提交真实密钥。
VISION_API_KEY=
# 候选视觉模型，必须按百炼控制台的账号地域与实际模型权限核对。
# https://help.aliyun.com/zh/model-studio/qwen-vl-api
VISION_MODEL=qwen3-vl-plus
# 未配置 VISION_API_KEY 时 Cloudflare Worker 仍使用其 AI binding。

# 豆包/火山方舟（与上面的百炼配置二选一）：
# 方舟 OpenAI 兼容接口基址：
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_API_KEY=你的方舟 API Key（仅服务端，勿提交）
# VISION_MODEL=你在方舟控制台创建的视觉模型接入点 ID
